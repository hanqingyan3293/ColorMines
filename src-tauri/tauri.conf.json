{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Mines",
  "version": "0.1.0",
  "identifier": "app.colormines.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Color Mines 颜色扫雷",
        "width": 1200,
        "height": 880,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "label": "main",
        "additionalBrowserArgs": "--disk-cache-size=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
